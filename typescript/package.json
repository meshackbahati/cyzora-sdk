{
  "name": "cyzora",
  "version": "1.0.0",
  "description": "Official-style Cyzora M-Pesa payment rail SDK for Node.js and TypeScript — charges, checkout, payouts, wallets and webhook verification.",
  "keywords": [
    "cyzora",
    "mpesa",
    "payments",
    "payouts",
    "kenya",
    "mobile-money",
    "stk"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "5.5"
  }
}
